# macOS Finder metadata
.DS_Store

# SwiftPM generated folder – everything inside is recreated automatically
.swiftpm/

# Xcode user data (in case you open the package as a workspace)
*.xcworkspace
*.xcuserdata/
DerivedData/

# Uncomment the next line if you want to ignore the lock file
# Package.resolved

# Binaries are GitHub release assets in Idmission-LLC/ios-sdk-releases (Package.swift has their url + checksum), never committed
Frameworks/
*.xcframework/
.build/
